/_site/
/.cache/
/notebook-exports/.cache/
/LocalPreferences.toml
.DS_Store

# Per-file Quarto execute caches, superseded by the committed _freeze/ and
# slides/_freeze/. check_structure.jl bans these anywhere under the four
# source trees, so we keep them out of git as they're regenerated.
prerequisites/**/*_files/
chapters/**/*_files/
appendices/**/*_files/
slides/**/*_files/
notebooks/**/*_files/
# Reveal.js and other resources a single-file render drops beside the freeze.
# A full render writes them to the output directory instead and deletes these,
# so check_freeze_drift.jl rejects them if they reach git.
_freeze/**/libs/
slides/_freeze/**/libs/

prerequisites/*.log
chapters/*.log
appendices/*.log
slides/*.log
appendices/solutions/*.html

*.jl.cov
*.jl.*.cov
*.jl.mem

**/*.quarto_ipynb

/_pdf/
/index_files/
/modeling-epidemics-with-julia.tex

/.quarto/
