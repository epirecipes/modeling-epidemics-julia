#!/bin/sh
# CairoMakie's display() writes the figure to a temporary PNG and then calls
# xdg-open, which in a container has no desktop to open it on, so it gives up
# with "Can't find a way to open a browser". Handing the file to the editor
# instead makes it appear as an image tab.
#
# The argument needs tidying first. CairoMakie builds the URL as
# "file:///" * path, and path is already absolute, so what arrives here is
# file:////tmp/jl_XXXX/display.png with four slashes. VSCode cannot resolve
# that and shows "An error occurred while loading the image", so the scheme is
# stripped and the leading slashes collapsed back to a plain path.
#
# Installed into /usr/local/bin at container-creation time rather than baked
# into the image, so it reaches codespaces started from an image built before
# this existed.

normalise() {
    target=$1
    case "$target" in
        file://*)
            target=${target#file://}
            while [ "${target#/}" != "$target" ]; do
                target=${target#/}
            done
            target="/$target"
            ;;
    esac
    printf '%s' "$target"
}

# CairoMakie writes the figure into a directory made by mktempdir(), which
# Julia deletes when the process exits. From `julia -e` that happens the moment
# display() returns, so the file is gone before the editor has opened it and the
# tab reports "An error occurred while loading the image". Taking a copy first
# makes the figure outlive the process that drew it. Only paths under the
# temporary directory are copied, so opening a file from the workspace still
# opens that file rather than a copy of it.
keep() {
    source_path=$1
    case "$source_path" in
        /tmp/*|"${TMPDIR:-/tmp}"/*)
            [ -f "$source_path" ] || { printf '%s' "$source_path"; return; }
            keep_dir="$HOME/.cache/julia-figures"
            mkdir -p "$keep_dir" || { printf '%s' "$source_path"; return; }
            # Yesterday's figures are of no further interest.
            find "$keep_dir" -type f -mtime +1 -delete 2>/dev/null
            kept="$keep_dir/$(date +%Y%m%d-%H%M%S)-$$-$(basename "$source_path")"
            cp "$source_path" "$kept" 2>/dev/null && source_path=$kept
            ;;
    esac
    printf '%s' "$source_path"
}

count=$#
index=0
while [ "$index" -lt "$count" ]; do
    argument=$1
    shift
    set -- "$@" "$(keep "$(normalise "$argument")")"
    index=$((index + 1))
done

if command -v code >/dev/null 2>&1; then
    exec code "$@"
fi

echo "xdg-open: no editor available; open $* manually" >&2
exit 1
