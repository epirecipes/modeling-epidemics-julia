{
  "name": "Modeling epidemics with Julia",
  // The image is built and published by .github/workflows/devcontainer-image.yml
  // from the Dockerfile beside this file, with every course package already
  // compiled into it. A codespace therefore starts by pulling an image rather
  // than by spending an hour precompiling. Rebuild it whenever Project.toml,
  // Manifest.toml or the Dockerfile change.
  "image": "ghcr.io/epirecipes/modeling-epidemics-julia-devcontainer:latest",
  "remoteUser": "vscode",

  // The image already carries the depot, so this only has to notice a manifest
  // that has moved on since the image was published, and repair it. It costs a
  // few seconds when the two agree.
  // Two independent jobs at creation time: repair the packages if the manifest
  // has moved on since the image was built, and install an xdg-open that opens
  // a figure in the editor instead of looking for a desktop that is not there.
  "postCreateCommand": {
    "packages": ".devcontainer/instantiate.sh",
    "figure-display": "sudo install -m 0755 .devcontainer/xdg-open /usr/local/bin/xdg-open"
  },

  // Loading this stack, and running the agent-based and inference material,
  // needs more than the 2-core default comfortably provides. This raises the
  // floor on the machine a participant can pick; it also spends their
  // Codespaces quota twice as fast as a 2-core machine would.
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },

  "customizations": {
    "vscode": {
      "extensions": [
        "julialang.language-julia",
        "quarto.quarto"
      ],
      "settings": {
        "julia.environmentPath": "${containerWorkspaceFolder}",
        "julia.useRevise": false,

        // Julia is installed from the tarball in the Dockerfile, not through
        // juliaup. The extension resolves the REPL from PATH and so finds it,
        // but the language server's precedence is
        // languageServerExecutablePath > languageServerJuliaupChannel >
        // `julia +release`, so without the second setting it hunts for juliaup,
        // fails, and shows a modal offering to install it. Naming the binary
        // for both stops the prompt and keeps the language server running.
        // These belong here rather than in a tracked .vscode/settings.json:
        // the path only exists inside this container.
        "julia.executablePath": "/usr/local/bin/julia",
        "julia.languageServerExecutablePath": "/usr/local/bin/julia",
        "julia.juliaup.install.hint": false,
        "files.watcherExclude": {
          "**/_freeze/**": true,
          "**/_site/**": true
        }
      }
    }
  },

  // Pluto's default port, for the notebook units. openBrowser rather than
  // openPreview: GitHub serves forwarded ports with frame-blocking headers, so
  // VS Code's embedded Simple Browser cannot display Pluto and shows a refusal
  // about the page being embedded by another site. A real tab works.
  "forwardPorts": [1234],
  "portsAttributes": {
    "1234": { "label": "Pluto", "onAutoForward": "openBrowser" }
  },

  // JULIA_PROJECT="@." makes a bare `julia` in the terminal activate the nearest
  // Project.toml, walking up from the working directory, so the REPL, `julia`
  // scripts and Pluto all see the course packages without --project=. and
  // participants cannot land in the default environment by accident. Explicit
  // --project flags still win, so `julia --project=environments/ch10` and the
  // exeflags in _quarto.yml behave as they always have. containerEnv rather
  // than remoteEnv so it applies to every process, not only VS Code terminals.
  "containerEnv": {
    "JULIA_PROJECT": "@.",
    "JULIA_NUM_THREADS": "auto"
  }
}
